{
  "name": "baywatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "fetch": "OUT_DIR=src/web/public/data node --experimental-strip-types src/fetcher/main.ts",
    "build": "vite build --config vite.config.ts && rm -rf dist/site/data && esbuild src/fetcher/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/fetcher/fetch.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
